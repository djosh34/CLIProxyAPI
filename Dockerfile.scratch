# Minimal API-only image: a static binary and the CA bundle on scratch.
# Build context is the CLIProxyAPI source tree, e.g.
#   docker buildx build -f Dockerfile.scratch --platform linux/amd64,linux/arm64 .

FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS builder

# Use the Go version from go.mod, so newer upstream tags still build.
ENV GOTOOLCHAIN=auto

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_DATE=unknown

RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -buildvcs=false -tags timetzdata \
    -ldflags "-s -w -X 'main.Version=${VERSION}' -X 'main.Commit=${COMMIT}' -X 'main.BuildDate=${BUILD_DATE}'" \
    -o /out/cli-proxy-api ./cmd/server

FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/cli-proxy-api /cli-proxy-api

USER 65532:65532
EXPOSE 8317
ENTRYPOINT ["/cli-proxy-api"]
